pkgname=metune
pkgver=0.1.0
pkgrel=2
pkgdesc='Clean MeTube music videos for Emby: tidy names, decade genre, −14 LUFS audio, cropped bars'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal' 'ffmpeg' 'curl')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/metune "$pkgdir/usr/bin/metune"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/metune.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/metune.svg"
  install -Dm644 "$startdir/metune.desktop" "$pkgdir/usr/share/applications/metune.desktop"
}
